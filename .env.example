# Copy to .env and fill in real values locally. Never commit .env.
ENVIRONMENT=development

# Backend <-> Postgres (docker compose default shown; change for Neon later)
DATABASE_URL=postgresql+psycopg://finscope:finscope@localhost:5432/finscope

# Backend <-> Redis (docker compose default shown; change for managed Redis later)
REDIS_URL=redis://localhost:6379/0

# Shared secret required on all protected, non-webhook, non-health API routes
API_KEY=

# Comma-separated frontend origins allowed to call the API (CORS). Only read
# when ENVIRONMENT is not "development" -- in development, localhost:3000
# and :3001 are always allowed regardless of this value.
CORS_ALLOWED_ORIGINS=

# Razorpay Test Mode (used starting in the Action/Integration phase)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Phase 10: a second, explicit confirmation gate. RazorpayClient (see
# app.providers.razorpay) refuses to construct unless this is exactly
# "true" AND RAZORPAY_KEY_ID has the rzp_test_ prefix -- both are required,
# neither alone is sufficient. Leave unset/false until you have confirmed
# the configured key is a genuine TEST-mode key.
RAZORPAY_TEST_MODE_CONFIRMED=

# Anthropic API (used starting in the Investigation phase; see
# app.providers.reasoning.HostedReasoningProvider). ANTHROPIC_MODEL and
# ANTHROPIC_TIMEOUT_SECONDS are optional -- unset, they default to
# claude-sonnet-5 and 30 seconds (see app.config.Settings) -- so leaving
# them blank never breaks startup. ANTHROPIC_WORKSPACE_ID is also optional
# and only needed if your API key is identity-linked to a Console
# workspace; the workspace header is only ever sent when this is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_TIMEOUT_SECONDS=
ANTHROPIC_WORKSPACE_ID=

# Optional observability
SENTRY_DSN=

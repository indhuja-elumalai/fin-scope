# Copy to .env and fill in real values locally. Never commit .env.
ENVIRONMENT=development

# Backend <-> Postgres (docker compose default shown; change for Neon later)
DATABASE_URL=postgresql+psycopg://finscope:finscope@localhost:5432/finscope

# Backend <-> Redis (docker compose default shown; change for managed Redis later)
REDIS_URL=redis://localhost:6379/0

# Shared secret required on all protected, non-webhook, non-health API routes
API_KEY=

# Razorpay Test Mode (used starting in the Action/Integration phase)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Anthropic API (used starting in the Investigation phase)
ANTHROPIC_API_KEY=

# Optional observability
SENTRY_DSN=

# Used client-side by the health-status page (public /health endpoint only,
# no secret involved).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only: used by Next.js Route Handlers (app/api/*) to call the
# FIN-SCOPE backend on the frontend's behalf, so the shared API key never
# reaches the browser. Must match the backend's API_KEY (see root .env).
API_BASE_URL=http://localhost:8000
API_KEY=
